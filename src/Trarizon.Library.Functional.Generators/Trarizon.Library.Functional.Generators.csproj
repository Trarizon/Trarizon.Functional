<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <TrarizonRoslynVersion>Modern</TrarizonRoslynVersion>
    </PropertyGroup>

    <Import Project="..\SourceGenerator.props" />
    
    <PropertyGroup>
        <Version>1.0.5-alpha.25</Version>
    </PropertyGroup>

    <!-- References -->

    <PropertyGroup Condition="$(TrarizonRoslynVersion) == 'Modern'">
        <DefineConstants>$(DefineConstants);ROSLYN_4_9_2_OR_GREATER</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="$(TrarizonRoslynVersion) == 'Modern'">
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    </ItemGroup>
    <ItemGroup Condition="$(TrarizonRoslynVersion) != 'Modern'">
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.3.0" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="PolySharp">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Trarizon.Library.Roslyn" PrivateAssets="all" GeneratePathProperty="true" />
    </ItemGroup>

    <!--Dependency-->

    <ItemGroup>
        <_GeneratorDependencyDlls Include="$(PKGTrarizon_Library_Roslyn)/build/bin/roslyn_$(TrarizonRoslynVersion)/*.dll" />
    </ItemGroup>

    <PropertyGroup>
        <GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetDependencyTargetPaths</GetTargetPathDependsOn>
    </PropertyGroup>

    <Target Name="GetDependencyTargetPaths">
        <ItemGroup>
            <TargetPathWithTargetPlatformMoniker Include="@(_GeneratorDependencyDlls)" IncludeRuntimeDependency="false" />
        </ItemGroup>
    </Target>

    <Target Name="CopyDependenciesToOutput" AfterTargets="Build">
        <Copy SourceFiles="@(_GeneratorDependencyDlls)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    </Target>

    <!--End Dependency-->

</Project>